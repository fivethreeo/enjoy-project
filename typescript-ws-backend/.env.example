HOST=127.0.0.1
PORT=8002
APP_NAME=template

# Server-only Django location and shared token; never expose these to browsers.
DJANGO_INTERNAL_URL=http://127.0.0.1:8000/
DJANGO_INTERNAL_AUTH_TOKEN=
DJANGO_SESSION_COOKIE_NAME=sessionid
# Exact browser origins allowed to open WebSockets, including anonymous clients.
WS_ALLOWED_ORIGINS=http://127.0.0.1:8000
# Shared with trusted notification senders; empty disables /internal/notify/.
WS_INTERNAL_NOTIFY_TOKEN=
