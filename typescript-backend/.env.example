HOST=127.0.0.1
PORT=8001
APP_NAME=template

# Server-only Django location and shared token; never expose these to browsers.
DJANGO_INTERNAL_URL=http://127.0.0.1:8000/
DJANGO_INTERNAL_AUTH_TOKEN=
DJANGO_SESSION_COOKIE_NAME=sessionid

# Server-only WS notification destination and credentials for trusted senders.
WS_INTERNAL_URL=http://127.0.0.1:8002/
WS_INTERNAL_NOTIFY_TOKEN=
