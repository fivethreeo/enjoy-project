DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to whether typescript-frontend/ exists; disable it explicitly if needed.
# DJANGO_FRONTEND_ENABLED=false
# Dev allows localhost:3000, 127.0.0.1:3000 and the RSBUILD_BASE_URL origin.
# Override the list explicitly; an empty value disables the defaults.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cookie-authenticated cross-origin requests also need credentials and CSRF trust.
# DJANGO_CORS_ALLOW_CREDENTIALS=true
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set /django for a deployment mounted at /django/; leave empty for root.
DJANGO_SCRIPT_NAME=

# Browser-facing URLs or gateway paths; parallel sets dev URLs automatically.
# Leave empty for an unavailable backend.
DJANGO_TS_BACKEND_URL=
DJANGO_TS_WS_BACKEND_URL=

# Server-only shared token for /internal/auth/; empty disables the endpoint.
DJANGO_INTERNAL_AUTH_TOKEN=

# Server-only notification destination and shared WS token; empty disables sending.
WS_INTERNAL_URL=http://127.0.0.1:8002/
WS_INTERNAL_NOTIFY_TOKEN=

# Leave the database name empty to keep SQLite in development.
DJANGO_DATABASE_NAME=
DJANGO_DATABASE_USER=template
DJANGO_DATABASE_PASSWORD=
DJANGO_DATABASE_HOST=127.0.0.1
DJANGO_DATABASE_PORT=5432

# Leave empty to retain Django's local-memory cache.
DJANGO_MEMCACHED_LOCATION=
DJANGO_CACHE_KEY_PREFIX=template

# Production: DEBUG=false requires a secret key and database name.
# Set persistent roots outside the code checkout when deploying.
# DJANGO_STATIC_ROOT=/srv/template/static
# DJANGO_MEDIA_ROOT=/srv/template/media
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_TRUST_PROXY_HEADERS=true
# Shared-origin deployment: isolate assets and cookies from other applications.
# DJANGO_STATIC_URL=/template/static/
# DJANGO_MEDIA_URL=/template/media/
# DJANGO_SESSION_COOKIE_NAME=template_sessionid
# DJANGO_CSRF_COOKIE_NAME=template_csrftoken
# DJANGO_SESSION_COOKIE_PATH=/template/
# DJANGO_CSRF_COOKIE_PATH=/template/

# Dev defaults to a separate local SQLite broker; no RabbitMQ is required.
# Production deployment supplies the application's RabbitMQ credentials/vhost.
CELERY_BROKER_URL=
# Optional; leave empty when task results are not needed.
# Enable result storage for the job-results endpoint, for example:
# CELERY_RESULT_BACKEND=db+sqlite:///celery-results.sqlite3
CELERY_RESULT_BACKEND=
